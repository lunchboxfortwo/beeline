{
  "name": "buzzy",
  "version": "0.0.0",
  "private": true,
  "description": "The merge you hold from your phone.",
  "workspaces": [
    "apps/api",
    "apps/auth",
    "apps/body",
    "apps/server",
    "packages/*"
  ],
  "scripts": {
    "release": "node packages/scripts/release.mjs",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:invite-web": "esbuild apps/site/join/invite-source.js --bundle --format=iife --minify --platform=browser --target=es2022 --outfile=apps/site/join/invite.js",
    "lint": "npm run lint:typecheck && npm run lint:shell && npm run lint:workflows && npm run lint:referenced-paths",
    "lint:ui-components": "node packages/scripts/check-mobile-ui-components.mjs",
    "lint:phone-network": "node packages/scripts/check-phone-network-channels.mjs",
    "test:phone-network": "node --test packages/scripts/phone-network-channels.test.mjs",
    "lint:typecheck": "npm run typecheck",
    "lint:shell": "git ls-files -z -- '*.sh' | xargs -0 shellcheck",
    "lint:workflows": "docker run --rm --user 0 -v \"$PWD:/repo\" -w /repo ghcr.io/beeline-work/ci-actionlint:1.7.7@sha256:887a259a5a534f3c4f36cb02dca341673c6089431057242cdc931e9f133147e9 -config-file .github/actionlint.yaml",
    "lint:referenced-paths": "node packages/scripts/verify-referenced-paths.mjs && node --test packages/scripts/verify-referenced-paths.test.mjs",
    "dead-code:prepare": "turbo run build",
    "predead-code": "npm run dead-code:prepare",
    "dead-code": "node packages/scripts/check-dead-code.mjs",
    "predead-code:baseline": "npm run dead-code:prepare",
    "dead-code:baseline": "node packages/scripts/check-dead-code.mjs --write-baseline",
    "typecheck": "node packages/scripts/check-stone-surfaces.mjs && node --test packages/scripts/check-stone-surfaces.test.mjs && turbo run typecheck && npm run typecheck --prefix apps/mobile && tsc -p packages/scripts/tsconfig.scripts.json",
    "test": "turbo run test",
    "feedback:group": "node packages/scripts/feedback-signals.mjs",
    "test:feedback-signals": "node --test packages/scripts/feedback-signals.test.mjs",
    "prove:command-once": "node --import tsx packages/scripts/prove-command-once.mjs",
    "prove:onboarding": "node packages/scripts/onboarding-walkthrough.mjs",
    "prove:agent-invitation-picker": "node --import tsx packages/scripts/prove-agent-invitation-picker.mjs",
    "prove:session-join-help": "node packages/scripts/prove-session-join-help.mjs",
    "prove:agent-invitations": "node --import tsx packages/scripts/prove-agent-invitations.mjs",
    "replay:agent-invitations": "node --import tsx packages/scripts/replay-agent-invitations.mjs",
    "build:agent-invitation-guides": "node --import tsx packages/scripts/generate-agent-invitation-guides.mjs",
    "prove:stop-invocation": "npm exec -- turbo run build --filter=@beeline/server... && node --import tsx packages/scripts/prove-stop-invocation.mjs",
    "prove:free-agent:docker-machines": "node packages/scripts/free-agent-docker-machines.mjs",
    "review:exact-head": "node packages/scripts/review-exact-head.mjs",
    "prompt-cases": "node --import tsx packages/scripts/prompt-cases.ts",
    "prompt:nightly": "node --import tsx packages/scripts/prompt-nightly.mjs",
    "test:prompt-cases": "node --import tsx --test packages/scripts/prompt-truthfulness.test.mjs packages/scripts/prompt-messaging-replay.test.mjs && node --import tsx packages/scripts/prompt-cases.ts && node --import tsx packages/scripts/prompt-surface.ts --check",
    "test:deploy": "node --test packages/scripts/desktop-r2.test.mjs packages/scripts/unified-release.test.mjs packages/scripts/release-channel.test.mjs packages/scripts/helper-downloads.test.mjs packages/scripts/npm-package-visibility.test.mjs packages/scripts/smoke-helper-package.test.mjs packages/scripts/release-artifact-allowlist.test.mjs",
    "test:web-deploy": "node --test packages/scripts/verify-web-deployment.test.mjs",
    "check:app-association-drift": "node packages/scripts/check-app-association-drift.mjs",
    "test:play": "node --test packages/scripts/play-token.test.mjs",
    "install:beeline": "bash packages/scripts/install-beeline.sh",
    "bundle:beeline": "node packages/scripts/build-beeline-bundle.mjs",
    "verify:beeline-install": "node packages/scripts/verify-beeline-install.mjs",
    "measure:providers": "node packages/scripts/provider-special-cases.mjs",
    "measure:agent-tools": "node --import tsx packages/scripts/measure-agent-tool-surface.ts",
    "measure:corner-wake": "node --import tsx packages/scripts/measure-corner-wake.ts",
    "mobile:install": "npm install --prefix apps/mobile",
    "corner:prepare": "node packages/scripts/prepare-corner.mjs",
    "game-host": "node packages/scripts/runnable-artifact-proxy.mjs",
    "mobile:web": "npm run web --prefix apps/mobile",
    "mobile:typecheck": "npm run typecheck --prefix apps/mobile",
    "prompt:discovery": "node --import tsx packages/scripts/discovery-live.mjs",
    "test:prompt-discovery": "node --import tsx --test packages/scripts/discovery-launch.test.mjs",
    "build:x-attribution": "esbuild apps/site/x-attribution-source.ts --bundle --format=iife --minify --platform=browser --target=es2022 --outfile=apps/site/x-attribution.js",
    "backfill:luna": "node packages/scripts/backfill-luna.mjs",
    "prove:tool-output": "npx turbo run build --filter=@beeline/body... --filter=@beeline/server... --concurrency=2 && node packages/scripts/prove-tool-output.mjs",
    "lint:router": "node packages/scripts/check-router-boundaries.mjs",
    "codecs:generate": "node packages/scripts/generate-network-codecs.mjs",
    "codecs:check": "node packages/scripts/generate-network-codecs.mjs --check",
    "test:router-boundaries": "node --test packages/scripts/router-boundaries.test.mjs"
  },
  "devDependencies": {
    "@actions/expressions": "0.3.61",
    "@colbymchenry/codegraph": "^1.6.0",
    "@types/node": "^22.9.0",
    "esbuild": "^0.28.1",
    "js-tiktoken": "1.0.21",
    "knip": "^5.88.1",
    "playwright": "^1.65.0",
    "prettier": "^3.3.3",
    "turbo": "^2.3.0",
    "typescript": "^5.6.3",
    "yaml": "2.9.0"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "packageManager": "npm@10.8.0",
  "volta": {
    "node": "20.11.0"
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 100,
    "tabWidth": 2,
    "arrowParens": "always"
  }
}
