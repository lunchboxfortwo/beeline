+      let f; try { f = JSON.parse(String(payload)); } catch { return; }
+      const span = f.t === 'res' && pending.get(f.id);
+      if (span) { span.replyEpochMs = Date.now(); span.ok = f.ok; pending.delete(f.id); }
+    });
+  });
+  return page;
