# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
build/
*.tsbuildinfo
.turbo/
.turbo-cache/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Env
.env
.env.local
.env.*.local

# Mobile
apps/mobile/ios/build/
apps/mobile/ios/Pods/
apps/mobile/android/build/
apps/mobile/android/.gradle/
apps/mobile/android/app/build/
apps/mobile/android/app/.cxx/
apps/mobile/android/.cxx/
apps/mobile/android/local.properties

# Coverage
coverage/

# Build artifacts (release APK/AAB ship as release assets, not tracked files)
*.apk
*.aab

# CLI bundles are built in-tree but published to Pages and GitHub Release assets.
apps/site/dl/manifest.json
apps/site/dl/*.tar.gz
apps/site/dl/*.tar.gz.sha256
apps/site/dl/beeline-bootstrap.mjs
apps/site/dl/beeline-bootstrap.mjs.sha256

# Mac
.DS_Store

# Local agent/build scratch (not committed)
.codegraph/
.scratch/
.scratch-target/
.beeline-tools/
apps/infra/free-agent/helper-bundle/

# Expo (apps/mobile isolated install)
apps/mobile/node_modules/
apps/mobile/.expo/
apps/mobile/dist/
apps/mobile/web-build/
apps/mobile/.turbo/
# Local iOS signing certificate/profile paths and password (EAS local credentials).
apps/mobile/credentials.json

# Agent runtime homes (sessions, credentials, caches) never belong in the repository.
agent-home/
# Isolated voice proof output (including local session tokens), never ship it.
/.voice-proof/
/.beeline-proof/

# Native component proof adapters share the mobile dependency install.
/apps/mobile/surface-proof/node_modules

# Dependency mount request, consumed by the helper on activation.
.beeline-dependency-request

# Helper dependency requests for disposable copies
.beeline-extra-dependencies/

# Exact-head CI build archive metadata
.beeline-ci-build.json

# Generated from README.md by packages/scripts/build-usebeeline-package.mjs
packages/usebeeline/README.md

# Local evidence and tool scratch never belong in the public tree.
/.artifacts/
/.cgstack/
/.lavish/
/.screenshots/
/.verification/
/artifacts/
/audit-evidence/
/evidence/
/proof/
/data/
/spec.md
/.editorconfig
/.nvmrc
/.prettierrc

# Keep root dotfiles limited to repository configuration.
/.*
!/.gitignore
!/.github/
!/.gitlab-ci.yml
!/.dockerignore
